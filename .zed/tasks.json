[
  {
    "label": "vcpkg install (x64)",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x64.cmd",
    "args": [
      "zig",
      "build",
      "vcpkg",
      "-p",
      "build"
    ]
  },
  {
    "label": "vcpkg install (x86)",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x86.cmd",
    "args": [
      "zig",
      "build",
      "vcpkg",
      "-p",
      "build",
      "-Dtarget=x86-windows-msvc"
    ]
  },
  {
    "label": "build",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x64.cmd",
    "args": [
      "zig",
      "build",
      "-p",
      "build",
      "-Dvcpkg_installed=build/vcpkg_installed/x64-windows"
    ]
  },
  {
    "label": "build (x86)",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x86.cmd",
    "args": [
      "zig",
      "build",
      "-p",
      "build",
      "-Dtarget=x86-windows-msvc",
      "-Dvcpkg_installed=build/vcpkg_installed/x86-windows"
    ]
  },
  {
    "label": "build release",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x64.cmd",
    "args": [
      "zig",
      "build",
      "-p",
      "build",
      "-Doptimize=ReleaseSafe",
      "-Dvcpkg_installed=build/vcpkg_installed/x64-windows"
    ]
  },
  {
    "label": "build release (x86)",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x86.cmd",
    "args": [
      "zig",
      "build",
      "-p",
      "build",
      "-Dtarget=x86-windows-msvc",
      "-Doptimize=ReleaseSafe",
      "-Dvcpkg_installed=build/vcpkg_installed/x86-windows"
    ]
  },
  {
    "label": "clean rebuild",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x64.cmd",
    "args": [
      "zig",
      "build",
      "--prefix",
      "build",
      "-Dvcpkg_installed=build/vcpkg_installed/x64-windows",
      "--cache-dir",
      ".zig-cache",
      "--summary",
      "all"
    ]
  },
  {
    "label": "test",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x64.cmd",
    "args": [
      "zig",
      "build",
      "test",
      "-p",
      "build",
      "-Dvcpkg_installed=build/vcpkg_installed/x64-windows"
    ]
  },
  {
    "label": "test (x86)",
    "reveal": "no_focus",
    "save": "all",
    "command": "./tools/vsdev-x86.cmd",
    "args": [
      "zig",
      "build",
      "test",
      "-p",
      "build",
      "-Dtarget=x86-windows-msvc",
      "-Dvcpkg_installed=build/vcpkg_installed/x86-windows"
    ]
  }
]
