{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/refs/heads/master/Help/manual/presets/schema.json",
  "version": 10,
  "include": [
    "common.json"
  ],
  "configurePresets": [
    {
      "name": "sys-linux",
      "description": "Linux: build for host architecture",

      "inherits": "common",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "sys-linux-release",
      "description": "Linux: build for host architecture (release)",

      "inherits": "sys-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}